# ============================================================
# Docker 部署环境变量模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.docker.example .env
#   2. 填写真实值（至少改 SECRET_KEY 和 LLM_API_KEY）
#   3. docker compose up -d --build
#
# 这个文件是 docker-compose.yml 读取的统一模板。
# docker-compose.yml 里 backend 和 algorithm 分别用 env_file 引用各自目录的 .env，
# 所以实际部署时需要把对应配置分别放到 backend/.env 和 algorithm/.env。
# 本模板把两部分放一起方便对照，部署时拆到对应目录即可。

# ============================================================
# 第一部分：后端服务配置（放到 backend/.env）
# ============================================================

# 运行环境（Docker 部署用 production）
ENVIRONMENT=production

# JWT 密钥 —— 生产环境必须替换为至少 32 字符的随机值！
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为至少32字符的随机密钥
TOKEN_EXPIRE_HOURS=168

# 日志级别
LOG_LEVEL=INFO

# AI 出题配额
AI_STUDENT_DAILY_REQUEST_LIMIT=5
AI_STUDENT_MAX_QUESTIONS=10
AI_STAFF_DAILY_REQUEST_LIMIT=30

# 算法服务地址（Docker 网络内通过服务名访问，这里由 compose 注入，无需手填）
# AI_SERVICE_URL=http://algorithm:8001

# CORS 允许源（留空=放开所有源；经 nginx 同源代理时无需特别配置）
# 多个用逗号分隔，如：https://your-domain.com,http://localhost
CORS_ORIGINS=

# ===== 向量嵌入 API（RAG 升级，可选） =====
# 配置后启用向量语义检索；留空自动回退 TF-IDF 匹配，不影响出题
# 推荐 Silicon Flow（免费额度 + BGE 中文最佳）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ============================================================
# 第二部分：算法服务配置（放到 algorithm/.env）
# ============================================================

# LLM 厂商：qwen / deepseek / zhipu / openai
LLM_PROVIDER=deepseek

# LLM API Key —— 必填，否则出题/判题/Agent 返回 503
LLM_API_KEY=sk-请填写你的API Key

# OpenAI 兼容端点
# - 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# - DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
# - 通义千问：qwen-plus
# - DeepSeek：deepseek-chat
LLM_MODEL=deepseek-chat

# 调用参数
LLM_TIMEOUT=120
LLM_MAX_RETRY=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# 服务端口（compose 注入，无需手填）
# AI_SERVICE_PORT=8001

# 跨源（compose 注入）
# AI_CORS_ORIGINS=http://localhost,http://backend:8000
